{
  "schemaVersion": 1,
  "key": "iam.access_review.reminder",
  "version": 1,
  "owner": {
    "domain": "identity",
    "service": "QimErp.Platform"
  },
  "summary": "An access review still has decisions waiting on the reviewer.",
  "channels": [
    "email"
  ],
  "audiences": [
    {
      "key": "reviewer",
      "recipient": {
        "source": "platform",
        "from": "userId"
      }
    }
  ],
  "references": [
    {
      "name": "userId",
      "type": "id",
      "required": true,
      "sensitivity": "Internal"
    }
  ],
  "fields": [
    {
      "name": "FirstName",
      "type": "text",
      "required": false,
      "source": "platform",
      "sensitivity": "Pii",
      "resolvedAt": "precheck",
      "example": "Sample",
      "resolvedFrom": "recipient.firstName"
    },
    {
      "name": "ReviewName",
      "type": "text",
      "required": true,
      "source": "producer",
      "sensitivity": "Internal",
      "resolvedAt": "precheck",
      "example": "Example access review"
    },
    {
      "name": "DueDate",
      "type": "date",
      "required": true,
      "source": "producer",
      "sensitivity": "Internal",
      "resolvedAt": "precheck",
      "example": "2026-11-14"
    },
    {
      "name": "ActionUrl",
      "type": "url",
      "required": true,
      "source": "platform",
      "sensitivity": "Internal",
      "resolvedAt": "precheck",
      "example": "https://app.example.qimerp.com/example/reports/user-access",
      "resolvedFrom": "workspace.appUrl",
      "url": {
        "host": "platform-frontend",
        "purpose": "workspace_app"
      }
    }
  ]
}
