{
  "schemaVersion": 1,
  "key": "payroll.payslip.ready",
  "version": 1,
  "owner": {
    "domain": "payroll",
    "service": "QimErp.Payroll"
  },
  "summary": "A payslip was published; tells the employee to view it in Payroll.",
  "channels": [
    "email"
  ],
  "audiences": [
    {
      "key": "employee",
      "recipient": {
        "source": "platform",
        "from": "recipientId"
      }
    }
  ],
  "references": [
    {
      "name": "recipientId",
      "type": "id",
      "required": true,
      "sensitivity": "Internal"
    }
  ],
  "fields": [
    {
      "name": "FirstName",
      "type": "text",
      "required": false,
      "source": "platform",
      "sensitivity": "Pii",
      "resolvedAt": "precheck",
      "example": "Sample",
      "resolvedFrom": "recipient.firstName"
    },
    {
      "name": "Period",
      "type": "text",
      "required": true,
      "source": "producer",
      "sensitivity": "Internal",
      "resolvedAt": "precheck",
      "example": "October 2026"
    },
    {
      "name": "DocumentName",
      "type": "text",
      "required": true,
      "source": "producer",
      "sensitivity": "Internal",
      "resolvedAt": "precheck",
      "example": "Payslip October 2026"
    },
    {
      "name": "ActionUrl",
      "type": "url",
      "required": true,
      "source": "platform",
      "sensitivity": "Internal",
      "resolvedAt": "precheck",
      "example": "https://payroll.example.qimerp.com/example/payroll/my-payslips",
      "resolvedFrom": "payroll.appUrl",
      "url": {
        "host": "payroll-app",
        "purpose": "payroll_app"
      }
    },
    {
      "name": "TenantName",
      "type": "text",
      "required": true,
      "source": "platform",
      "sensitivity": "Internal",
      "resolvedAt": "precheck",
      "example": "Example Tenant",
      "resolvedFrom": "tenant.name"
    },
    {
      "name": "TenantInitials",
      "type": "text",
      "required": true,
      "source": "platform",
      "sensitivity": "Internal",
      "resolvedAt": "precheck",
      "example": "ET",
      "resolvedFrom": "tenant.initials"
    }
  ]
}
