{
  "schemaVersion": 1,
  "key": "people.onboarding_task.escalated",
  "version": 1,
  "owner": {
    "domain": "people",
    "service": "QimErp.CoreHr"
  },
  "summary": "An onboarding task was escalated to the manager or HR.",
  "channels": [
    "email"
  ],
  "audiences": [
    {
      "key": "employee",
      "recipient": {
        "source": "platform",
        "from": "recipientId"
      }
    }
  ],
  "references": [
    {
      "name": "recipientId",
      "type": "id",
      "required": true,
      "sensitivity": "Internal"
    }
  ],
  "fields": [
    {
      "name": "FirstName",
      "type": "text",
      "required": false,
      "source": "platform",
      "sensitivity": "Pii",
      "resolvedAt": "precheck",
      "example": "Sample",
      "resolvedFrom": "recipient.firstName"
    },
    {
      "name": "EmployeeName",
      "type": "text",
      "required": true,
      "source": "producer",
      "sensitivity": "Pii",
      "resolvedAt": "precheck",
      "example": "Sample Employee"
    },
    {
      "name": "TaskTitle",
      "type": "text",
      "required": true,
      "source": "producer",
      "sensitivity": "Internal",
      "resolvedAt": "precheck",
      "example": "Example task"
    },
    {
      "name": "DueDate",
      "type": "text",
      "required": true,
      "source": "producer",
      "sensitivity": "Internal",
      "resolvedAt": "precheck",
      "example": "Fri, 14 Nov 2026"
    },
    {
      "name": "ActorName",
      "type": "text",
      "required": true,
      "source": "producer",
      "sensitivity": "Pii",
      "resolvedAt": "precheck",
      "example": "Sample Actor"
    },
    {
      "name": "Message",
      "type": "text",
      "required": true,
      "source": "producer",
      "sensitivity": "Confidential",
      "resolvedAt": "precheck",
      "example": "Example note."
    },
    {
      "name": "TenantName",
      "type": "text",
      "required": true,
      "source": "platform",
      "sensitivity": "Internal",
      "resolvedAt": "precheck",
      "example": "Example Tenant",
      "resolvedFrom": "tenant.name"
    },
    {
      "name": "TenantInitials",
      "type": "text",
      "required": true,
      "source": "platform",
      "sensitivity": "Internal",
      "resolvedAt": "precheck",
      "example": "ET",
      "resolvedFrom": "tenant.initials"
    },
    {
      "name": "ActionUrl",
      "type": "url",
      "required": true,
      "source": "platform",
      "sensitivity": "Internal",
      "resolvedAt": "precheck",
      "example": "https://people.example.qimerp.com/example/hr/onboarding/00000000-0000-4000-8000-000000000001",
      "resolvedFrom": "people.appUrl",
      "url": {
        "host": "people-app",
        "purpose": "people_app"
      }
    }
  ]
}
