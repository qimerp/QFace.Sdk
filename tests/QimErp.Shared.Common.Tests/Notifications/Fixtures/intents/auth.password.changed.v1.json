{
  "schemaVersion": 1,
  "key": "auth.password.changed",
  "version": 1,
  "owner": {
    "domain": "identity",
    "service": "QimErp.Platform"
  },
  "summary": "The account password was changed by its holder.",
  "channels": [
    "email"
  ],
  "audiences": [
    {
      "key": "account_holder",
      "recipient": {
        "source": "platform",
        "from": "userId"
      }
    }
  ],
  "references": [
    {
      "name": "userId",
      "type": "id",
      "required": true,
      "sensitivity": "Internal"
    }
  ],
  "fields": [
    {
      "name": "FirstName",
      "type": "text",
      "required": false,
      "source": "platform",
      "sensitivity": "Pii",
      "resolvedAt": "precheck",
      "example": "Sample",
      "resolvedFrom": "recipient.firstName"
    },
    {
      "name": "WorkspaceUrl",
      "type": "hostname",
      "required": true,
      "source": "platform",
      "sensitivity": "Internal",
      "resolvedAt": "precheck",
      "example": "workspace.example.qimerp.com",
      "resolvedFrom": "tenant.workspaceHost"
    },
    {
      "name": "OccurredAt",
      "type": "datetime",
      "required": true,
      "source": "producer",
      "sensitivity": "Internal",
      "resolvedAt": "precheck",
      "example": "2026-11-07T09:42:00Z"
    },
    {
      "name": "Device",
      "type": "text",
      "required": false,
      "source": "producer",
      "sensitivity": "Pii",
      "resolvedAt": "precheck",
      "example": "Example browser"
    },
    {
      "name": "Location",
      "type": "text",
      "required": false,
      "source": "producer",
      "sensitivity": "Pii",
      "resolvedAt": "precheck",
      "example": "Example city"
    },
    {
      "name": "ActionUrl",
      "type": "url",
      "required": true,
      "source": "platform",
      "sensitivity": "Internal",
      "resolvedAt": "precheck",
      "example": "https://app.example.qimerp.com/example",
      "resolvedFrom": "workspace.appUrl",
      "url": {
        "host": "platform-frontend",
        "purpose": "workspace_app"
      }
    }
  ]
}
