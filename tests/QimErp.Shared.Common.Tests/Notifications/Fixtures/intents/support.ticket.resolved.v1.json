{
  "schemaVersion": 1,
  "key": "support.ticket.resolved",
  "version": 1,
  "owner": {
    "domain": "support",
    "service": "QimErp.Operator"
  },
  "summary": "A support ticket was resolved.",
  "channels": [
    "email"
  ],
  "audiences": [
    {
      "key": "requester",
      "recipient": {
        "source": "platform",
        "from": "recipientId"
      }
    }
  ],
  "references": [
    {
      "name": "recipientId",
      "type": "id",
      "required": true,
      "sensitivity": "Internal"
    }
  ],
  "fields": [
    {
      "name": "FirstName",
      "type": "text",
      "required": false,
      "source": "platform",
      "sensitivity": "Pii",
      "resolvedAt": "precheck",
      "example": "Sample",
      "resolvedFrom": "recipient.firstName"
    },
    {
      "name": "TicketNumber",
      "type": "text",
      "required": true,
      "source": "producer",
      "sensitivity": "Internal",
      "resolvedAt": "precheck",
      "example": "TCK-0001"
    },
    {
      "name": "TicketTitle",
      "type": "text",
      "required": true,
      "source": "producer",
      "sensitivity": "Confidential",
      "resolvedAt": "precheck",
      "example": "Example ticket title"
    },
    {
      "name": "Stage",
      "type": "text",
      "required": true,
      "source": "producer",
      "sensitivity": "Internal",
      "resolvedAt": "precheck",
      "example": "Resolved"
    },
    {
      "name": "OccurredAt",
      "type": "datetime",
      "required": true,
      "source": "producer",
      "sensitivity": "Internal",
      "resolvedAt": "precheck",
      "example": "2026-11-07T09:42:00Z"
    },
    {
      "name": "ActionUrl",
      "type": "url",
      "required": true,
      "source": "platform",
      "sensitivity": "Internal",
      "resolvedAt": "precheck",
      "example": "https://app.example.qimerp.com/example/support/TCK-0001",
      "resolvedFrom": "workspace.appUrl",
      "url": {
        "host": "platform-frontend",
        "purpose": "workspace_app"
      }
    }
  ]
}
