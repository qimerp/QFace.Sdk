{
  "schemaVersion": 1,
  "key": "auth.password_reset.requested",
  "version": 1,
  "owner": {
    "domain": "identity",
    "service": "QimErp.Platform"
  },
  "summary": "A password reset link was requested for an existing account.",
  "channels": [
    "email"
  ],
  "audiences": [
    {
      "key": "account_holder",
      "recipient": {
        "source": "platform",
        "from": "userId"
      }
    }
  ],
  "references": [
    {
      "name": "userId",
      "type": "id",
      "required": true,
      "sensitivity": "Internal"
    },
    {
      "name": "emailLinkLookupId",
      "type": "id",
      "required": true,
      "sensitivity": "Confidential"
    }
  ],
  "fields": [
    {
      "name": "FirstName",
      "type": "text",
      "required": false,
      "source": "platform",
      "sensitivity": "Pii",
      "resolvedAt": "precheck",
      "example": "Sample",
      "resolvedFrom": "recipient.firstName"
    },
    {
      "name": "WorkspaceUrl",
      "type": "hostname",
      "required": true,
      "source": "platform",
      "sensitivity": "Internal",
      "resolvedAt": "precheck",
      "example": "workspace.example.qimerp.com",
      "resolvedFrom": "tenant.workspaceHost"
    },
    {
      "name": "OccurredAt",
      "type": "datetime",
      "required": true,
      "source": "producer",
      "sensitivity": "Internal",
      "resolvedAt": "precheck",
      "example": "2026-11-07T09:42:00Z"
    },
    {
      "name": "LinkExpiresAt",
      "type": "datetime",
      "required": true,
      "source": "platform",
      "sensitivity": "Internal",
      "resolvedAt": "afterPrecheck",
      "example": "2026-11-07T10:42:00Z",
      "resolvedFrom": "link.expiresAt"
    },
    {
      "name": "ActionUrl",
      "type": "url",
      "required": true,
      "source": "platform",
      "sensitivity": "Sensitive",
      "resolvedAt": "afterPrecheck",
      "example": "https://app.example.qimerp.com/reset-password?token=EXAMPLE",
      "resolvedFrom": "link.url",
      "url": {
        "host": "platform-frontend",
        "purpose": "password_reset",
        "reference": "emailLinkLookupId",
        "singleUse": true
      }
    }
  ]
}
