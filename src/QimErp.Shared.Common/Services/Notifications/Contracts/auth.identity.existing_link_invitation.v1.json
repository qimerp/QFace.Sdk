{
  "schemaVersion": 1,
  "key": "auth.identity.existing_link_invitation",
  "version": 1,
  "owner": {
    "domain": "identity",
    "service": "QimErp.Platform"
  },
  "summary": "Confirm workspace account access",
  "channels": [
    "email"
  ],
  "audiences": [
    {
      "key": "existing_account_holder",
      "recipient": {
        "source": "platform",
        "from": "userId"
      }
    }
  ],
  "references": [
    {
      "name": "userId",
      "type": "id",
      "required": true,
      "sensitivity": "Internal"
    },
    {
      "name": "emailLinkLookupId",
      "type": "id",
      "required": true,
      "sensitivity": "Confidential"
    }
  ],
  "fields": [
    {
      "name": "FirstName",
      "type": "text",
      "required": false,
      "source": "platform",
      "sensitivity": "Pii",
      "resolvedAt": "precheck",
      "example": "Sample",
      "resolvedFrom": "recipient.firstName"
    },
    {
      "name": "TenantName",
      "type": "text",
      "required": true,
      "source": "platform",
      "sensitivity": "Internal",
      "resolvedAt": "precheck",
      "example": "Example Workspace",
      "resolvedFrom": "tenant.name"
    },
    {
      "name": "LinkExpiresAt",
      "type": "datetime",
      "required": true,
      "source": "platform",
      "sensitivity": "Internal",
      "resolvedAt": "afterPrecheck",
      "example": "2026-11-24T17:00:00Z",
      "resolvedFrom": "link.expiresAt"
    },
    {
      "name": "ActionUrl",
      "type": "url",
      "required": true,
      "source": "platform",
      "sensitivity": "Sensitive",
      "resolvedAt": "afterPrecheck",
      "example": "https://example.invalid/invitation",
      "resolvedFrom": "link.url",
      "url": {
        "host": "platform-frontend",
        "purpose": "account_activation",
        "reference": "emailLinkLookupId",
        "singleUse": true
      }
    }
  ]
}
